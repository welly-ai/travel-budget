{
  "baseUrl": "http://127.0.0.1:3000",
  "items": [
    {
      "id": "login",
      "title": "登入頁",
      "description": "未登入時所有頁面都會導到這裡。",
      "route": "/login",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "waitFor": "input[name=\"email\"]"
    },
    {
      "id": "projects",
      "title": "專案列表",
      "description": "代碼、名稱、LOB、Phase、Class、總人天、最後修改者與時間。",
      "route": "/projects",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=\"email\"]",
          "value": "demo@example.com"
        },
        {
          "action": "fill",
          "selector": "input[name=\"password\"]",
          "value": "demo-password-123"
        },
        {
          "action": "click",
          "selector": "button[type=\"submit\"]"
        },
        {
          "action": "wait",
          "selector": "table tbody tr"
        }
      ]
    },
    {
      "id": "project-desktop",
      "title": "專案頁（桌機）",
      "description": "左側改設定，右側 Stage × Function 人天矩陣即時重算；下方是最近 5 筆修訂。",
      "route": "/projects/SYN01",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=\"email\"]",
          "value": "demo@example.com"
        },
        {
          "action": "fill",
          "selector": "input[name=\"password\"]",
          "value": "demo-password-123"
        },
        {
          "action": "click",
          "selector": "button[type=\"submit\"]"
        },
        {
          "action": "wait",
          "selector": "[data-testid=\"matrix\"]"
        }
      ]
    },
    {
      "id": "project-mobile",
      "title": "專案頁（手機）",
      "description": "手機上設定在上、矩陣可左右捲動。",
      "route": "/projects/SYN01",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=\"email\"]",
          "value": "demo@example.com"
        },
        {
          "action": "fill",
          "selector": "input[name=\"password\"]",
          "value": "demo-password-123"
        },
        {
          "action": "click",
          "selector": "button[type=\"submit\"]"
        },
        {
          "action": "wait",
          "selector": "[data-testid=\"matrix\"]"
        }
      ]
    },
    {
      "id": "project-override",
      "title": "格子手動覆寫與警告",
      "description": "點 Core-1 × A 格子，把人次改成 3：比 Guidance 多 +200%，超過上限 30%，理由欄變必填。",
      "route": "/projects/SYN03",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=\"email\"]",
          "value": "demo@example.com"
        },
        {
          "action": "fill",
          "selector": "input[name=\"password\"]",
          "value": "demo-password-123"
        },
        {
          "action": "click",
          "selector": "button[type=\"submit\"]"
        },
        {
          "action": "wait",
          "selector": "[data-testid=\"matrix\"]"
        },
        {
          "action": "click",
          "selector": "td[data-testid=\"cell-Core-1-A\"] button"
        },
        {
          "action": "fill",
          "selector": "[role=\"dialog\"] input[type=\"number\"]",
          "value": "3"
        },
        {
          "action": "wait",
          "selector": "[data-testid=\"override-warning\"]"
        }
      ]
    },
    {
      "id": "settings-tolerance",
      "title": "容許範圍設定",
      "description": "列出各組上下限，可新增一組或就地編輯；不同廠區或專案可用不同組。",
      "route": "/settings/tolerance",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=\"email\"]",
          "value": "demo@example.com"
        },
        {
          "action": "fill",
          "selector": "input[name=\"password\"]",
          "value": "demo-password-123"
        },
        {
          "action": "click",
          "selector": "button[type=\"submit\"]"
        },
        {
          "action": "wait",
          "selector": "h1, h2"
        }
      ]
    }
  ]
}

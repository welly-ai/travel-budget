{
  "description": "Stop 品質關卡與 PreToolUse 防護；規則見 docs/hooks.md。指令以 Codex 的工作目錄（專案根目錄）為基準。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/codex-pretooluse.mjs",
            "timeout": 10,
            "statusMessage": "Checking project guardrails"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/codex-stop.mjs",
            "timeout": 600,
            "statusMessage": "Running project quality gate"
          }
        ]
      }
    ]
  }
}

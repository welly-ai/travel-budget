# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 真實公司資料只放本機，不進 git（見 AGENTS.md「資料分級」）
/local-data/*
!/local-data/README.md
*.xlsx
*.xlsm
!tests/fixtures/synthetic/*.xlsx

# SQLite
*.db
*.db-wal
*.db-shm

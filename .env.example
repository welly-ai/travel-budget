# 複製成 .env.local 後修改（.env.local 不進 git）。

# 資料庫檔案位置（預設 data/travel-budget.db）
# DATABASE_PATH=data/travel-budget.db

# 登入用的密鑰：正式環境必填，至少 32 字元。本機開發不填會用內建的開發用密鑰。
# 產生方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=

# 網站對外的網址（預設 http://127.0.0.1:3000）
# BETTER_AUTH_URL=http://127.0.0.1:3000

# MCP（/api/mcp）的存取權杖。沒設定時 MCP 端點一律回 401（等於關閉）。
# 產生方式同上。用戶端在 Authorization: Bearer <權杖> 帶入。
MCP_TOKEN=

# 設成 example 可強制匯出用虛構版面（不讀 local-data/excel-layout.json）
# EXCEL_LAYOUT=example
